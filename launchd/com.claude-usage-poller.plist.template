<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE - do not copy this file to ~/Library/LaunchAgents by hand.

  __NODE__ and __PROJECT__ are substituted by tools/install-launchd.sh, which
  reads them from your actual checkout. Hardcoding them here is what made the
  old plist work on exactly one machine.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude-usage-poller</string>

  <!-- Absolute paths required: launchd runs with a minimal PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PROJECT__/poller/poll.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>

  <!-- How often poll.mjs is RUN, not how often it fetches. The script gates
       its own requests (see poller/poll.mjs) and most runs exit without
       touching the network, which is what makes a tick this short affordable
       against an undocumented endpoint. Substituted from `poll.minSeconds` in
       config/config.json so the cadence has one source of truth - do not edit
       the interval here. -->
  <key>StartInterval</key>
  <integer>__INTERVAL__</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT__/poller.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/poller.log</string>
</dict>
</plist>
