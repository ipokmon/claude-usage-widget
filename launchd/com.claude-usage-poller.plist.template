<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE - do not copy this file to ~/Library/LaunchAgents by hand.

  __NODE__ and __PROJECT__ are substituted by tools/install-launchd.sh, which
  reads them from your actual checkout. Hardcoding them here is what made the
  old plist work on exactly one machine.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude-usage-poller</string>

  <!-- Absolute paths required: launchd runs with a minimal PATH. -->
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PROJECT__/poller/poll.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT__</string>

  <!-- 600s = 10 minutes. Deliberately conservative: this is an undocumented
       internal endpoint, and usage limits move slowly enough that polling
       harder buys nothing but rate-limit risk. This is the ONLY place the
       interval is set. -->
  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT__/poller.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT__/poller.log</string>
</dict>
</plist>
